# Username shown on the admin login form.
ADMIN_USERNAME=admin
# Exactly one verified administrator email used internally for Supabase Auth.
# Keep this allowlist server-side; never accept an admin role from the browser.
ADMIN_EMAILS=administrator@example.com

# Required for Supabase JWT verification and admin User Management.
# This must be the SAME Supabase project used by frontend/.env.
# Get these from Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_AUDIENCE=authenticated
FRONTEND_URL=http://localhost:3000

# Brevo SMTP (server-side only)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM_EMAIL=your_verified_sender_email

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PENDING_PASSWORD_ENCRYPTION_KEY=your_fernet_key
