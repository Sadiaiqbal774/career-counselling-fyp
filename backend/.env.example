# Required for the administrator login endpoints.
# Keep this username separate from registered student accounts.
ADMIN_USERNAME=administrator
ADMIN_PASSWORD=replace-with-a-long-random-password

# Required for admin User Management and Assessment monitoring
# (must be the SAME Supabase project used by frontend/.env).
# Get these from Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key