# PostgreSQL connection - either full URL or components
DATABASE_URL=your_database_connection_string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT secret
# This legacy Express server is disabled. Authentication is handled by Supabase Auth.

# Frontend base URL used in emails
FRONTEND_URL=http://localhost:3000

# (Optional) SMTP settings for nodemailer. If omitted tokens are logged to console.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

